# Auria Tweak - persistent system props (safe & value-stable).
# Runtime-only props are applied by engine.sh after boot.

# Rendering / compositor
debug.composition.type=gpu
debug.hwui.renderer=skiavk
persist.sys.jank_detect_interval=10

# Input smoothness (from Project Raco / AZenith lineage)
ro.max.fling_velocity=10000